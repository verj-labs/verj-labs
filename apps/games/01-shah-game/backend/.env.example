# ─────────────────────────────────────────────
# Application
# ─────────────────────────────────────────────
NODE_ENV=development
PORT=3000

# ─────────────────────────────────────────────
# PostgreSQL (matches docker-compose defaults)
# ─────────────────────────────────────────────
DATABASE_URL=postgresql://shah:shah_secret@localhost:5432/shah_exchange

POSTGRES_USER=shah
POSTGRES_PASSWORD=shah_secret
POSTGRES_DB=shah_exchange

# ─────────────────────────────────────────────
# Redis
# ─────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─────────────────────────────────────────────
# Session / Auth
# ─────────────────────────────────────────────
SESSION_SECRET=replace-me-with-a-long-random-string

# ─────────────────────────────────────────────
# CORS
# ─────────────────────────────────────────────
# URL of the frontend app. Defaults to http://localhost:5173 when unset.
FRONTEND_URL=http://localhost:5173
